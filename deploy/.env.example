# Copy to deploy/.env or export these vars before docker compose

# Portable bind mount for the repository inside the sreagent container.
# Default works when running from repo root with:
# docker compose -f deploy/docker-compose.local.yml up -d --build
SREAGENT_APP_PATH=..

# Optional Telegram delivery for the demo
SREAGENT_TELEGRAM_CHAT_ID=
SREAGENT_TELEGRAM_BOT_TOKEN_FILE=./secrets/telegram_bot_token.txt

# Local Grafana demo credentials
GRAFANA_ADMIN_PASSWORD=admin
