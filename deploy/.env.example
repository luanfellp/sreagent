# Copy to deploy/.env or export these vars before docker compose

# Portable bind mount for the repository inside the sreagent container.
# Default works when running from repo root with:
# docker compose -f deploy/docker-compose.local.yml up -d --build
SREAGENT_APP_PATH=..

# Optional notification delivery for the demo
SREAGENT_NOTIFICATION_CHANNELS=telegram
SREAGENT_TELEGRAM_CHAT_ID=
SREAGENT_TELEGRAM_BOT_TOKEN_FILE=./secrets/telegram_bot_token.txt
SREAGENT_WHATSAPP_PHONE_NUMBER_ID=
SREAGENT_WHATSAPP_ACCESS_TOKEN=
SREAGENT_WHATSAPP_TO=

# Optional links shown in alert notifications
SREAGENT_GRAFANA_URL=http://localhost:3000
SREAGENT_ZABBIX_URL=http://localhost:8080

# Keep resolved Alertmanager groups out of the response by default.
# Set to true only if you want explicit resolved summaries in the webhook response.
SREAGENT_ALERTMANAGER_EMIT_RESOLVED=false

# Local Grafana demo credentials
GRAFANA_ADMIN_PASSWORD=admin
